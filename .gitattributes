# Unity YAML / text assets — normal git text, never LFS
*.cs          text diff=csharp
*.meta        text -diff merge=unityyamlmerge eol=lf
*.unity       text -diff merge=unityyamlmerge eol=lf
*.prefab      text -diff merge=unityyamlmerge eol=lf
*.mat         text -diff merge=unityyamlmerge eol=lf
*.asset       text -diff merge=unityyamlmerge eol=lf
*.anim        text -diff merge=unityyamlmerge eol=lf
*.controller  text -diff merge=unityyamlmerge eol=lf
*.physicMaterial text -diff merge=unityyamlmerge eol=lf

# Images / textures
